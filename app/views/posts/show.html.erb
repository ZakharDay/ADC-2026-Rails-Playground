<p style="color: green"><%= notice %></p>

<%= render @post %>

<div>
  <%= link_to "Back to posts", posts_path %>

  <% if can? :manage, @post %>
    <%= link_to "Edit this post", edit_post_path(@post) %>
    <%= link_to "Destroy this post", @post, data: { turbo_stream: false, turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
  <% end %>
</div>

<h2>Comments</h2>

<div id="comments">
  <% @post.comments.each do |comment| %>
    <%= render comment %>

    <% if can? :manage, comment %>
      <p>
        <%= link_to "Destroy Comment", [@post, comment], data: { turbo_stream: false, turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
      </p>
    <% end %>
  <% end %>
</div>

<div>
  <%= render "comments/form" %>
</div>

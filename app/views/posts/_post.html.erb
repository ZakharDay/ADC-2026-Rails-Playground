<div id="<%= dom_id post %>">
  <%= image_tag post.cover.url, width: 600 if post.cover.present? %>

  <div>
    <strong>Title:</strong>
    <%= post.title %>
  </div>

  <div>
    <strong>Body:</strong>
    <%= post.body %>
  </div>

  <div>
    <strong>Author:</strong>
    <%= post.user.email %>
  </div>

</div>
